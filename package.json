{
  "name": "cc-dash",
  "version": "0.1.0",
  "description": "Web dashboard for running and monitoring many Claude Code sessions side by side",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cc-dash": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "launch": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "setup": "node scripts/setup.js",
    "setup:remove": "node scripts/setup.js --remove",
    "shortcut": "node scripts/shortcut.js",
    "shortcut:remove": "node scripts/shortcut.js --remove",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "marked": "18.1.0",
    "mermaid": "12.2.0",
    "node-pty": "1.2.0-beta.15",
    "ws": "8.22.0"
  }
}
